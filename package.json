{
  "name": "need-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:widget": "tsc --noEmit && vite build --mode widget",
    "build:server": "npm run build:widget && vite build --mode server",
    "start": "node dist-server/index.js --http",
    "start:stdio": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:deploy": "npm run build:server && cp dist-server/index.js deploy/need-quest-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "canvas-confetti": "1.9.3",
    "framer-motion": "11.11.17",
    "lottie-web": "5.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.6.4",
    "@types/node": "^22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.5"
  },
  "bin": {
    "need-quest-mcp": "dist-server/index.js"
  }
}
